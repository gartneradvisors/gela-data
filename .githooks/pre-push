#!/bin/sh
# Segunda revisión: todo lo que se va a subir a GitHub, commit por commit.
z=0000000000000000000000000000000000000000
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z" ] && continue
  if [ "$remote_sha" = "$z" ]; then range="$(git rev-list --max-parents=0 "$local_sha" | tail -1)..$local_sha"; else range="$remote_sha..$local_sha"; fi
  for c in $(git rev-list "$range"); do
    python3 tools/guard.py --range "$c~1..$c" >/dev/null 2>&1 || { python3 tools/guard.py --range "$c~1..$c"; echo "Commit $c"; exit 1; }
  done
done
exit 0
